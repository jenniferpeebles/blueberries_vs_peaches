ga_blueberry_counties_probe <- nassqs(
  sector_desc = "CROPS",
  group_desc = "FRUIT & TREE NUTS",
  commodity_desc = "BLUEBERRIES",
  agg_level_desc = "COUNTY",
  state_alpha = "GA",
  year = 2022,
  format = "json"
) |>
  janitor::clean_names()

ga_blueberry_counties_probe |>
  count(
    statisticcat_desc,
    class_desc,
    unit_desc,
    short_desc,
    sort = TRUE
  ) |>
  View()

ga_blueberry_counties_raw <- nassqs(
  sector_desc = "CROPS",
  group_desc = "FRUIT & TREE NUTS",
  commodity_desc = "BLUEBERRIES",
  class_desc = "TAME", # filter out Maine's wild blueberries
  agg_level_desc = "COUNTY",
  state_alpha = "GA",
  statisticcat_desc = "AREA BEARING",
  unit_desc = "ACRES",
  year = 2022,
  format = "json"
) |>
  janitor::clean_names()

glimpse(ga_blueberry_counties_raw)

# ------------------------------------------------------------
# Clean county blueberry data
# ------------------------------------------------------------

ga_blueberry_counties <- ga_blueberry_counties_raw |>
  mutate(
    value_num = clean_nass_value(value),

    county_name = county_name |>
      str_remove(" County") |>
      str_trim() |>
      str_to_upper()
  ) |>
  filter(!is.na(value_num)) |>
  group_by(county_name) |>
  summarize(
    blueberry_acres = sum(value_num, na.rm = TRUE),
    .groups = "drop"
  )

# ------------------------------------------------------------
# Pull Georgia counties shapefile
# ------------------------------------------------------------

options(tigris_use_cache = TRUE)

ga_counties <- tigris::counties(
  state = "GA",
  year = 2024,
  class = "sf"
) |>
  st_transform(4326)

# ------------------------------------------------------------
# Join spatial + USDA data
# ------------------------------------------------------------

ga_blueberry_counties_raw |>
  count(value, sort = TRUE)

county_blueberry_map <- ga_counties |>
  mutate(
    county_name = NAME |>
      str_remove(" County") |>
      str_trim() |>
      str_to_upper()
  ) |>
  left_join(
    ga_blueberry_counties,
    by = "county_name"
  )

sort(unique(ga_blueberry_counties$county_name))
sort(unique(ga_counties$NAME))

glimpse(county_blueberry_map)
