```{r pull_in_data, eval = TRUE, echo = FALSE, include = FALSE}
# ============================================================
# USDA NASS Quick Stats: peaches + blueberries by state/year
# Jennifer Peebles / AJC
# ============================================================

# Option 1: put your key in .Renviron as:
# NASS_API_KEY="your_key_here"
nassqs_auth(key = Sys.getenv("NASS_API_KEY"))
# ------------------------------------------------------------
# Helper: clean NASS value column
# ------------------------------------------------------------

clean_nass_value <- function(x) {
  if (is.numeric(x)) {
    return(x)
  }
  
  readr::parse_number(as.character(x))
}

# sanity check
exists("clean_nass_value")
clean_nass_value("1,234")

# ------------------------------------------------------------
# Pull production data
# ------------------------------------------------------------

pull_crop_production <- function(commodity, start_year = 2000, end_year = 2024) {

  nassqs(
    sector_desc = "CROPS",
    group_desc = "FRUIT & TREE NUTS",
    commodity_desc = commodity,
    agg_level_desc = "STATE",
    statisticcat_desc = "PRODUCTION",
    year__GE = start_year,
    year__LE = end_year,
    format = "json"
  ) |>
    clean_names() |>
    mutate(
      value_num = clean_nass_value(value),
      commodity = commodity
    )
}
