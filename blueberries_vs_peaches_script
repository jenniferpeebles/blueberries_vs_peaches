make_bump_chart_peach <- function(df, chart_title, chart_subtitle, filename_stub) {
  
  bump_df <- df |>
    filter(state_alpha %in% selected_peach_states) |>
    mutate(
      state_label = state_name
    )
  
  p <- bump_df |>
    ggplot(aes(x = year, y = rank, color = state_label, group = state_label)) +
    geom_line(linewidth = 1.2) +
    geom_point(size = 2) +
    scale_y_reverse(
