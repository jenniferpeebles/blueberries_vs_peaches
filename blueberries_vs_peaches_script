```{r rank_states_by_year, eval = TRUE, echo = FALSE, include = FALSE}

rank_states <- function(df) {
  df |>
    group_by(year) |>
    mutate(
      rank = min_rank(desc(production)),
      national_total = sum(production, na.rm = TRUE),
      pct_of_us = production / national_total
    ) |>
    ungroup()
}

peach_ranked <- rank_states(peaches)
blueberry_ranked <- rank_states(blueberries)

ga_summary <- bind_rows(peach_ranked, blueberry_ranked) |>
  filter(state_alpha == "GA") |>
  mutate(
    commodity_label = case_when(
      commodity == "PEACHES" ~ "Peaches",
      commodity == "BLUEBERRIES" ~ "Blueberries",
      TRUE ~ commodity
    )
  ) |>
  arrange(commodity_label, year)

ga_summary |>
  select(year, commodity_label, production, unit_desc, rank, pct_of_us) |>
  mutate(
    production_fmt = comma(production),
    pct_of_us = percent(pct_of_us, accuracy = 0.1)
  )

latest_year <- max(c(peach_ranked$year, blueberry_ranked$year), na.rm = TRUE)

latest_peaches <- peach_ranked |>
  filter(year == max(year, na.rm = TRUE)) |>
  arrange(rank) |>
  select(rank, state_name, production, unit_desc, pct_of_us)

latest_blueberries <- blueberry_ranked |>
  filter(year == max(year, na.rm = TRUE)) |>
  arrange(rank) |>
  select(rank, state_name, production, unit_desc, pct_of_us)

latest_peaches
latest_blueberries

